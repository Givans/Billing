# Auto detect text files and perform LF normalization
* text=auto

# These files are text and should be normalized (Convert to LF on checkout)
*.js text
*.json text
*.md text
*.txt text
*.yml text
*.yaml text
*.xml text
*.html text
*.css text
*.scss text
*.ts text
*.jsx text
*.tsx text

# These are binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary

# Force LF for specific files
package.json text eol=lf
package-lock.json text eol=lf